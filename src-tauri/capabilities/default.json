{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for main and overlay windows",
  "windows": ["main", "overlay"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-hide",
    "opener:default",
    "updater:default"
  ]
}
