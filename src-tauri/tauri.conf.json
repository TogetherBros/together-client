{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Together",
  "version": "1.0.7",
  "identifier": "com.n5rud.together-fe",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Together",
        "width": 460,
        "height": 660,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "center": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src ipc: http://ipc.localhost https://ipc.localhost wss://api.togetherbros.uk http://tauri.localhost; img-src 'self' asset: https://asset.localhost http://asset.localhost data: blob:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:;"
    },
    "macOSPrivateApi": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhDMjcwM0IzQzhFRUY5NzEKUldSeCtlN0lzd01uakRQZUdwOGFWN2VkdWNDTzdPZTRGTVgxMExXbENyaFRVNFhQVk9tRnR4OGwK",
      "endpoints": [
        "https://github.com/TogetherBros/together-client/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
